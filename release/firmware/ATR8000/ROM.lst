 890:     -	0004          	NSIDES	EQU	4		;NUMBER OF SIDES
 891:     -	0005          	MEDIA	EQU	5		;MEDIA SIZE AND FORMAT BITS
 892:     -	0006          	SECLEN	EQU	6		;SECTOR LENGTH (HI/LOW)
 893:     -	0008          	DSKBITS	EQU	8		;MISC NAUGHTY BITS
 894:     -	0009          	SPARE0	EQU	9
 895:     -	000A          	SPARE1	EQU	10
 896:     -	000B          	SPARE2	EQU	11
