 921:     -	0002          	BADRW	EQU	2		;BAD READ/WRITE OPERATION BIT
 922:     -	0003          	WRPROT	EQU	3		;WRITE PROTECTED BIT
 923:     -	0004          	ACTIVE	EQU	4		;DRIVE READY INDICATOR BIT
