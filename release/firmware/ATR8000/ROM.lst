  59: 7055+4	F51A  17      		RLA					;SHIFT DATA BIT (=MSB) INTO CARRY
  60: 7059+7	F51B  3E00    		LD	A,NULL			;LOAD A WITH PARTIAL DATA BYTE - NOTE THAT THIS VALUE RESETS AT LABEL RXDAT2
  61:     -	F51C          	RXTEMP	EQU	$-1
  62: 7066+4	F51D  1F      		RRA					;SHIFT NEW BIT IN AND ONES OUT
  63: 7070+7+5	F51E  38F0    		JR	C,RXDAT2
  64:				
  65: 7077+13	F520  3200FF  		LD	(KEYBUF),A		;STORE CHARACTER IN CIRCULAR BUFFER
